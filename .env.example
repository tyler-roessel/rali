# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
# Do not use the direct db.<ref>.supabase.co host (IPv6-only on new projects).
# Do not use the transaction pooler on port 6543 (breaks prepared statements/DDL).
SUPABASE_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Optional: Overpass endpoint override if the primary is unreachable.
# Default is https://overpass-api.de/api/interpreter.
# OVERPASS_URL=https://overpass.private.coffee/api/interpreter
